{
  "name": "mymanager",
  "private": true,
  "workspaces": ["app/client", "app/server"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=mymanager-server\" \"npm run dev --workspace=mymanager-client\"",
    "build": "npm run build --workspace=mymanager-client",
    "start": "npm run start --workspace=mymanager-server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}

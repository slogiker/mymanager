<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' ? title : 'MyManager' %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            font-family: 'Inter', system-ui, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        .page-container {
            width: 100%;
            max-width: 900px;
            margin: 0 auto;
            padding: 2rem 1.5rem 4rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2.5rem;
        }

        .header-nav a:hover {
            color: #e2e8f0;
        }

        /* Footer */
        .site-footer {
            padding: 3rem 0;
            text-align: center;
            color: #64748b;
            font-size: 0.9rem;
            border-top: 1px solid rgba(51, 65, 85, 0.4);
            margin-top: auto;
            width: 100%;
            background: rgba(15, 23, 42, 0.4);
            backdrop-filter: blur(8px);
        }

        /* Glass Card */
        .glass-card {
            width: 100%;
            background: rgba(30, 41, 59, 0.7);
            border: 1px solid rgba(51, 65, 85, 0.5);
            border-radius: 12px;
            padding: 2.5rem;
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        /* Auth Tabs Options */
        .auth-tabs {
            display: flex;
            background: rgba(15, 23, 42, 0.5);
            border-radius: 8px;
            padding: 0.25rem;
            margin-bottom: 2rem;
            border: 1px solid rgba(51, 65, 85, 0.6);
        }

        .auth-tab {
            flex: 1;
            text-align: center;
            padding: 0.75rem;
            border-radius: 6px;
            color: #94a3b8;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            border: none;
            background: transparent;
            font-size: 0.95rem;
        }

        .auth-tab.active {
            background: rgba(59, 130, 246, 0.2);
            color: #f1f5f9;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
        }

        .form-panel {
            display: none;
            animation: fadeIn 0.3s ease;
        }

        .form-panel.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Login Form */
        .login-form h3 {
            font-size: 1.5rem;
            margin: 0 0 1.5rem;
            color: #f1f5f9;
            font-weight: 600;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            margin-bottom: 1rem;
        }

        .form-group label {
            color: #94a3b8;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .form-group input {
            padding: 0.7rem 1rem;
            background: rgba(15, 23, 42, 0.5);
            border: 1px solid #334155;
            border-radius: 8px;
            color: #f1f5f9;
            font-size: 1rem;
            font-family: inherit;
            transition: all 0.3s ease;
        }

        .form-group input:focus {
            outline: none;
            border-color: #3b82f6;
            background: rgba(15, 23, 42, 0.8);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        }

        .form-group input::placeholder {
            color: #64748b;
        }

        .password-wrapper {
            position: relative;
        }

        .password-wrapper input {
            width: 100%;
            padding-right: 3rem;
            box-sizing: border-box;
        }

        #togglePassword {
            position: absolute;
            right: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #64748b;
            cursor: pointer;
            padding: 0.25rem;
            transition: color 0.2s;
        }

        #togglePassword:hover {
            color: #cbd5e1;
        }

        .submit-btn {
            width: 100%;
            padding: 0.75rem 2rem;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 0.5rem;
            font-family: inherit;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(59, 130, 246, 0.25);
        }

        .submit-btn:active {
            transform: translateY(0);
        }

        .form-footer {
            text-align: center;
            margin-top: 1.25rem;
            color: #64748b;
            font-size: 0.875rem;
        }

        .form-footer a {
            color: #60a5fa;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
        }

        .form-footer a:hover {
            color: #93c5fd;
        }

        .error-msg {
            background: rgba(239, 68, 68, 0.1);
            color: #fca5a5;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            border-left: 3px solid #ef4444;
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }

        /* Portfolio Section */
        .portfolio-section h3 {
            font-size: 1.5rem;
            margin: 0 0 1.25rem;
            color: #f1f5f9;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .portfolio-section h3 i {
            color: #94a3b8;
        }

        .readme-content {
            color: #94a3b8;
            line-height: 1.8;
            font-size: 0.95rem;
        }

        .readme-content a {
            color: #60a5fa;
            text-decoration: none;
            transition: color 0.2s;
        }

        .readme-content a:hover {
            color: #93c5fd;
            text-decoration: underline;
        }

        .readme-content h1,
        .readme-content h2,
        .readme-content h3 {
            color: #f1f5f9;
            margin-top: 1.5rem;
            margin-bottom: 0.5rem;
        }

        .readme-content h1 {
            font-size: 1.5rem;
        }

        .readme-content h2 {
            font-size: 1.25rem;
        }

        .readme-content h3 {
            font-size: 1.1rem;
        }

        .readme-content code {
            background: rgba(15, 23, 42, 0.5);
            padding: 0.15rem 0.4rem;
            border-radius: 4px;
            font-family: ui-monospace, monospace;
            color: #93c5fd;
            font-size: 0.875rem;
        }

        .readme-content ul,
        .readme-content ol {
            margin-left: 1.5rem;
            margin-top: 0.5rem;
            margin-bottom: 0.75rem;
        }

        .readme-content li {
            list-style: disc;
            margin-bottom: 0.25rem;
        }

        .readme-content img {
            max-width: 100%;
            border-radius: 8px;
            margin: 1rem 0;
        }

        .readme-content p {
            margin-bottom: 0.75rem;
        }

        .loading-spinner {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #64748b;
        }

        .loading-spinner i {
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        @media (max-width: 768px) {
            .page-container {
                padding: 1.5rem 1rem 3rem;
            }

            .glass-card {
                padding: 1.5rem;
            }

            .construction-message h2 {
                font-size: 1.8rem;
            }
        }
    </style>
</head>

<body>

    <!-- Header -->
    <%- include('partials/navbar') %>

        <div class="page-container">
            <div class="glass-card">

                <div class="auth-tabs">
                    <button
                        class="auth-tab <%= (typeof loginMode === 'undefined' || loginMode !== 'signup') ? 'active' : '' %>"
                        onclick="switchTab('login')">Sign In</button>
                    <button
                        class="auth-tab <%= (typeof loginMode !== 'undefined' && loginMode === 'signup') ? 'active' : '' %>"
                        onclick="switchTab('register')">Register</button>
                </div>

                <!-- LOGIN FORM -->
                <div id="login-panel"
                    class="form-panel <%= (typeof loginMode === 'undefined' || loginMode !== 'signup') ? 'active' : '' %>">
                    <form action="/login" method="POST" class="login-form">
                        <h3><i class="fa-solid fa-lock" style="color: #8b5cf6;"></i> Welcome Back</h3>

                        <div class="form-group">
                            <label for="login-username">Username</label>
                            <input id="login-username" name="username" type="text" required placeholder="Enter username"
                                autofocus>
                        </div>
                        <div class="form-group">
                            <label for="login-password">Password</label>
                            <div class="password-wrapper">
                                <input id="login-password" name="password" type="password" required
                                    placeholder="Enter password">
                                <button type="button" id="toggleLoginPassword" class="toggle-password"
                                    style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); background: none; border: none; color: #64748b; cursor: pointer; padding: 0.25rem;">
                                    <i class="fa-solid fa-eye text-sm"></i>
                                </button>
                            </div>
                        </div>
                        <button type="submit" class="submit-btn mt-4">
                            <i class="fa-solid fa-right-to-bracket"></i> Sign In
                        </button>
                    </form>
                </div>

                <!-- SIGNUP FORM -->
                <div id="register-panel"
                    class="form-panel <%= (typeof loginMode !== 'undefined' && loginMode === 'signup') ? 'active' : '' %>">
                    <form action="/register" method="POST" class="login-form">
                        <h3><i class="fa-solid fa-user-plus" style="color: #8b5cf6;"></i> Create Account</h3>

                        <div class="form-group">
                            <label for="name">Full Name</label>
                            <input id="name" name="name" type="text" required placeholder="Your full name">
                        </div>
                        <div class="form-group">
                            <label for="username">Username</label>
                            <input id="username" name="username" type="text" required placeholder="Choose a username">
                        </div>
                        <div class="form-group">
                            <label for="email">Email</label>
                            <input id="email" name="email" type="email" required placeholder="your@email.com">
                        </div>
                        <div class="form-group">
                            <label for="password">Password</label>
                            <div class="password-wrapper">
                                <input id="password" name="password" type="password" required
                                    placeholder="Minimum 6 characters">
                                <button type="button" id="toggleRegPassword" class="toggle-password"
                                    style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); background: none; border: none; color: #64748b; cursor: pointer; padding: 0.25rem;">
                                    <i class="fa-solid fa-eye text-sm"></i>
                                </button>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="confirmPassword">Confirm Password</label>
                            <div class="password-wrapper">
                                <input id="confirmPassword" name="confirmPassword" type="password" required
                                    placeholder="Repeat your password">
                                <button type="button" class="toggle-password"
                                    style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); background: none; border: none; color: #64748b; cursor: pointer; padding: 0.25rem;">
                                    <i class="fa-solid fa-eye text-sm"></i>
                                </button>
                            </div>
                        </div>
                        <button type="submit" class="submit-btn mt-4">
                            <i class="fa-solid fa-user-plus"></i> Register & Login
                        </button>
                    </form>
                </div>

            </div>



        </div>

        <!-- Global Footer -->
        <footer
            class="text-center py-8 text-slate-500 text-sm mt-auto w-full border-t border-slate-800 bg-slate-900/50 backdrop-blur-sm">
            <p>&copy; 2026 Daniel Pliberšek (slogiker). Built with Express, Tailwind concept & PostgreSQL.</p>
        </footer>

        <script>
            // Tab Switcher
            function switchTab(tab) {
                document.querySelectorAll('.auth-tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.form-panel').forEach(p => {
                    p.classList.remove('active');
                    // Disable required fields in hidden panels to prevent form validation errors
                    p.querySelectorAll('input[required]').forEach(input => {
                        input.removeAttribute('required');
                        input.setAttribute('data-was-required', 'true');
                    });
                });

                if (tab === 'login') {
                    document.querySelectorAll('.auth-tab')[0].classList.add('active');
                    const loginPanel = document.getElementById('login-panel');
                    loginPanel.classList.add('active');

                    // Re-enable required fields for active panel
                    loginPanel.querySelectorAll('input[data-was-required="true"]').forEach(input => {
                        input.setAttribute('required', 'true');
                    });

                    window.history.replaceState(null, null, '/login');
                } else {
                    document.querySelectorAll('.auth-tab')[1].classList.add('active');
                    const registerPanel = document.getElementById('register-panel');
                    registerPanel.classList.add('active');

                    // Re-enable required fields for active panel
                    registerPanel.querySelectorAll('input[data-was-required="true"]').forEach(input => {
                        input.setAttribute('required', 'true');
                    });

                    window.history.replaceState(null, null, '/register');
                }
            }

            // Toggle password visibility
            document.querySelectorAll('.toggle-password').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const pwField = btn.previousElementSibling;
                    const isPassword = pwField.type === 'password';
                    pwField.type = isPassword ? 'text' : 'password';
                    btn.querySelector('i').className = isPassword
                        ? 'fa-solid fa-eye-slash text-sm'
                        : 'fa-solid fa-eye text-sm';
                });
            });

            // Registration form validation
            document.querySelector('#register-panel form').addEventListener('submit', function (e) {
                const pwd = document.getElementById('password').value;
                const confirm = document.getElementById('confirmPassword').value;
                if (pwd !== confirm) {
                    e.preventDefault(); // Stop submission
                    Toastify({
                        text: "Passwords do not match!",
                        duration: 3000,
                        gravity: "top",
                        position: "right",
                        style: { background: "linear-gradient(to right, #ef4444, #fca5a5)" },
                        stopOnFocus: true
                    }).showToast();
                    document.getElementById('confirmPassword').value = ''; // Clear confirmation field
                    document.getElementById('confirmPassword').focus();
                }
            });
        </script>

        <!-- Toastify Flash Messages -->
        <% if (typeof messages !=='undefined' ) { %>
            <% if (messages.success && messages.success.length> 0) { %>
                <script>
                <% messages.success.forEach(function (msg) { %>
                    Toastify({
                        text: "<%= msg %>",
                        duration: 3000,
                        gravity: "top",
                        position: "right",
                        style: { background: "linear-gradient(to right, #00b09b, #96c93d)" },
                        stopOnFocus: true,
                    }).showToast();
                <% }); %>
                </script>
                <% } %>
                    <% if (messages.error && messages.error.length> 0) { %>
                        <script>
                <% messages.error.forEach(function (msg) { %>
                    Toastify({
                        text: "<%= msg %>",
                        duration: 3000,
                        gravity: "top",
                        position: "right",
                        style: { background: "linear-gradient(to right, #ff5f6d, #ffc371)" },
                        stopOnFocus: true,
                    }).showToast();
                <% }); %>
                        </script>
                        <% } %>
                            <% } %>

</body>

</html>
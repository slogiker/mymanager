<%- include('partials/header') %>

    <!-- ===== System Stats Section (Owner Only) ===== -->
    <% if (typeof sysStats !=='undefined' && sysStats) { %>
        <section class="mb-8">
            <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-2">
                <i class="fa-solid fa-microchip text-blue-500"></i> Server Status
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                <!-- CPU Card -->
                <div class="card p-5 group">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2 text-slate-400">
                            <i class="fa-solid fa-microchip text-blue-400"></i> CPU Usage
                        </div>
                        <div class="text-xs font-mono text-blue-400 font-bold bg-blue-500/10 px-2 py-1 rounded cursor-pointer hover:bg-blue-500/20 transition-colors"
                            onclick="toggleCpuMetric(this)"
                            data-speed="<%= sysStats.cpu.speedMain %> / <%= sysStats.cpu.speedMax %>"
                            data-load="<%= sysStats.cpu.load %>%">
                            <%= sysStats.cpu.load %>%
                        </div>
                    </div>
                    <div class="w-full bg-slate-800 rounded-full h-2 mb-2 shadow-inner overflow-hidden">
                        <div class="bg-blue-500 h-2 rounded-full transition-all duration-1000 shadow-[0_0_10px_rgba(59,130,246,0.6)]"
                            style="width: <%= Math.min(sysStats.cpu.load, 100) %>%"></div>
                    </div>
                    <div class="flex justify-between text-xs text-slate-500">
                        <span class="truncate max-w-[150px]" title="<%= sysStats.cpu.model %>">
                            <%= sysStats.cpu.model %>
                        </span>
                        <span>
                            <%= sysStats.cpu.cores %> Cores
                        </span>
                    </div>
                </div>

                <!-- Memory Card -->
                <div class="card p-5 group relative">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2 text-slate-400">
                            <i class="fa-solid fa-memory text-purple-400"></i> RAM Usage
                        </div>
                        <div class="text-xs font-mono text-purple-400 font-bold bg-purple-500/10 px-2 py-1 rounded cursor-help"
                            title="Top Processes:&#10;<%- (sysStats.memory.topProcesses || []).map(p => `${p.name}: ${p.memUsage} (${p.memPercent}%)`).join('&#10;') %>">
                            <%= sysStats.memory.used %> / <%= sysStats.memory.total %>
                        </div>
                    </div>
                    <div class="w-full bg-slate-800 rounded-full h-2 mb-2 shadow-inner overflow-hidden">
                        <div class="bg-purple-500 h-2 rounded-full transition-all duration-1000 shadow-[0_0_10px_rgba(168,85,247,0.6)]"
                            style="width: <%= sysStats.memory.percent %>%"></div>
                    </div>
                    <div class="flex justify-between text-xs text-slate-500">
                        <span>
                            <%= sysStats.memory.percent %>% Used
                        </span>
                        <span>
                            <%= sysStats.memory.free %> Free
                        </span>
                    </div>
                </div>

                <!-- Disk Card -->
                <% if (sysStats.disk && sysStats.disk.total !=='N/A' ) { %>
                    <div class="card p-5">
                        <div class="flex items-center justify-between mb-3">
                            <div class="flex items-center gap-2 text-slate-400">
                                <i class="fa-solid fa-hard-drive text-emerald-400"></i> Disk Space
                            </div>
                            <div
                                class="text-xs font-mono text-emerald-400 font-bold bg-emerald-500/10 px-2 py-1 rounded">
                                <%= sysStats.disk.used %> / <%= sysStats.disk.total %>
                            </div>
                        </div>
                        <div class="w-full bg-slate-800 rounded-full h-2 mb-2 shadow-inner overflow-hidden">
                            <div class="bg-emerald-500 h-2 rounded-full transition-all duration-1000 shadow-[0_0_10px_rgba(16,185,129,0.6)]"
                                style="width: <%= sysStats.disk.percent %>%"></div>
                        </div>
                        <div class="flex justify-between text-xs text-slate-500">
                            <span>
                                <%= sysStats.disk.percent %>% Used
                            </span>
                            <span>
                                <%= sysStats.disk.free %> Free
                            </span>
                        </div>
                    </div>
                    <% } %>

                        <!-- System Info Card -->
                        <div class="card p-5 flex flex-col justify-center">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-slate-400 text-sm"><i
                                        class="fa-solid fa-temperature-half text-orange-400 w-5"></i> Temp</span>
                                <span class="font-mono text-orange-400 font-bold">
                                    <%= sysStats.temperature %>
                                </span>
                            </div>
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-slate-400 text-sm"><i class="fa-solid fa-clock text-blue-400 w-5"></i>
                                    Uptime</span>
                                <span class="font-mono text-slate-300 text-xs">
                                    <%= sysStats.uptime %>
                                </span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400 text-sm"><i
                                        class="fa-brands fa-linux text-slate-300 w-5"></i> OS</span>
                                <span class="font-mono text-slate-400 text-[10px] truncate max-w-[120px]"
                                    title="<%= sysStats.platform %>">
                                    <%= sysStats.platform %>
                                </span>
                            </div>
                        </div>
            </div>
        </section>

        <script>
            function toggleCpuMetric(el) {
                const current = el.innerText.trim();
                const load = el.getAttribute('data-load');
                const speed = el.getAttribute('data-speed');
                if (current === load) {
                    el.innerText = speed;
                } else {
                    el.innerText = load;
                }
            }
        </script>
        <% } %>

            <!-- ===== Applications Section ===== -->
            <section class="mb-10">
                <div class="flex items-center justify-between mb-6">
                    <div class="flex items-center gap-4">
                        <h2 class="text-2xl font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-layer-group text-blue-500"></i> Applications
                        </h2>
                        <% if (typeof isVPNConnected !=='undefined' ) { %>
                            <% if (isVPNConnected) { %>
                                <div class="hidden sm:flex items-center gap-1.5 bg-green-500/10 px-2.5 py-1 rounded-full border border-green-500/30 shadow-[0_4px_12px_-2px_rgba(34,197,94,0.1)]"
                                    title="You are securely connected to the local network.">
                                    <div
                                        class="w-1.5 h-1.5 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.6)]">
                                    </div>
                                    <span class="text-[10px] uppercase font-bold text-green-400 tracking-wider">VPN
                                        Connected</span>
                                </div>
                                <% } else { %>
                                    <div class="hidden sm:flex items-center gap-1.5 bg-red-500/10 px-2.5 py-1 rounded-full border border-red-500/30 shadow-[0_4px_12px_-2px_rgba(239,68,68,0.1)]"
                                        title="You are accessing this remotely.">
                                        <div
                                            class="w-1.5 h-1.5 rounded-full bg-red-500 shadow-[0_0_8px_rgba(239,68,68,0.6)] animate-pulse">
                                        </div>
                                        <span class="text-[10px] uppercase font-bold text-red-400 tracking-wider">Public
                                            Network</span>
                                    </div>
                                    <% } %>
                                        <% } %>
                    </div>
                    <% if (user) { %>
                        <button onclick="openAddServiceModal()" class="btn btn-primary shadow-lg shadow-blue-500/20">
                            <i class="fa-solid fa-plus gap-2"></i> Add Service
                        </button>
                        <% } %>
                </div>

                <div id="servicesGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
                    <% services.forEach(service=> { %>
                        <div data-id="<%= service.id %>" class="card sortable-item group relative cursor-pointer"
                            onclick="window.open('<%= service.url %>', '_blank')">

                            <!-- Hover Actions -->
                            <% if (user) { %>
                                <div
                                    class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity flex gap-1.5 z-10">
                                    <button onclick="event.stopPropagation(); deleteService(<%= service.id %>)"
                                        class="p-2 bg-slate-700 hover:bg-red-500/20 hover:text-red-400 text-slate-400 rounded-lg transition-colors"
                                        title="Delete">
                                        <i class="fa-solid fa-trash text-xs"></i>
                                    </button>
                                    <div class="drag-handle cursor-grab p-2 bg-slate-700 hover:bg-slate-600 text-slate-400 rounded-lg"
                                        title="Drag to reorder">
                                        <i class="fa-solid fa-grip-vertical text-xs"></i>
                                    </div>
                                </div>
                                <% } %>

                                    <!-- Icon + Title -->
                                    <div class="flex items-start gap-4">
                                        <div
                                            class="w-12 h-12 rounded-xl bg-slate-700/50 flex items-center justify-center border border-slate-600 group-hover:scale-110 transition-transform duration-300 flex-shrink-0">
                                            <i class="fa-solid <%= service.icon %> text-xl text-blue-400"></i>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <h3 class="font-bold text-white mb-1 truncate">
                                                <%= service.title %>
                                            </h3>
                                            <p class="text-sm text-slate-400 line-clamp-2">
                                                <%= service.description %>
                                            </p>
                                        </div>
                                    </div>

                                    <!-- Status -->
                                    <div
                                        class="mt-4 pt-4 border-t border-slate-700/50 flex flex-wrap items-center justify-between gap-2 text-xs">
                                        <div class="flex items-center gap-2">
                                            <% if (service.status==='online' ) { %>
                                                <span
                                                    class="w-2 h-2 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.6)]"></span>
                                                <span class="text-green-400 font-medium">Online</span>
                                                <% } else if (service.status==='offline' ) { %>
                                                    <span class="w-2 h-2 rounded-full bg-red-500"></span>
                                                    <span class="text-red-400">Offline</span>
                                                    <% } else { %>
                                                        <span class="w-2 h-2 rounded-full bg-slate-500"></span>
                                                        <span class="text-slate-400">Unknown</span>
                                                        <% } %>
                                        </div>
                                        <div class="flex items-center gap-1.5 ml-auto">
                                            <% if (service.VPN) { %>
                                                <span
                                                    class="flex items-center gap-1 bg-red-500/10 px-2 py-0.5 rounded text-red-400 border border-red-500/20"
                                                    title="VPN Required">
                                                    <div class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse">
                                                    </div>
                                                    <span class="text-[10px] font-medium tracking-wide">VPN REQ</span>
                                                </span>
                                                <% } else { %>
                                                    <span
                                                        class="flex items-center gap-1 bg-green-500/10 px-2 py-0.5 rounded text-green-400 border border-green-500/20"
                                                        title="Publicly Available">
                                                        <div class="w-1.5 h-1.5 rounded-full bg-green-500"></div>
                                                        <span
                                                            class="text-[10px] font-medium tracking-wide">PUBLIC</span>
                                                    </span>
                                                    <% } %>
                                                        <% if (service.isPrivate) { %>
                                                            <span
                                                                class="bg-amber-500/10 px-2 py-0.5 rounded text-amber-400 border border-amber-500/20">
                                                                <i class="fa-solid fa-lock mr-1 text-[10px]"></i>Private
                                                            </span>
                                                            <% } %>
                                        </div>
                                    </div>
                        </div>
                        <% }); %>

                            <% if (services.length===0) { %>
                                <div
                                    class="col-span-full py-16 text-center text-slate-600 bg-slate-800/30 rounded-xl border border-dashed border-slate-700">
                                    <i class="fa-solid fa-ghost text-5xl mb-4 opacity-40 block"></i>
                                    <p class="text-lg font-medium">No services yet</p>
                                    <p class="text-sm mt-1">Add your first service to get started</p>
                                </div>
                                <% } %>
                </div>
            </section>

            <!-- ===== GitHub Repos Section ===== -->
            <section>
                <h2 class="text-2xl font-bold text-white mb-6">GitHub Repositories</h2>
                <div id="projectsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                    <% projects.forEach(project=> { %>
                        <div data-id="<%= project.id %>" class="card group cursor-pointer flex flex-col"
                            onclick="openProjectFromCard(this)" data-name="<%= project.name %>"
                            data-description="<%= project.description %>" data-language="<%= project.language %>"
                            data-url="<%= project.url %>" data-stars="<%= project.stars %>"
                            data-homepage="<%= project.homepage %>" data-clone="<%= project.clone_url %>"
                            data-ssh="<%= project.ssh_url %>">

                            <div class="flex items-center justify-between mb-4">
                                <div
                                    class="flex items-center gap-2 text-slate-400 group-hover:text-purple-400 transition-colors">
                                    <i class="fa-brands fa-github text-xl"></i>
                                    <span class="text-xs font-mono opacity-70">REPO</span>
                                </div>
                                <div
                                    class="flex items-center gap-1 text-xs font-bold px-2 py-1 bg-slate-900 rounded-lg border border-slate-700">
                                    <i class="fa-solid fa-star text-yellow-500"></i>
                                    <span>
                                        <%= project.stars %>
                                    </span>
                                </div>
                            </div>

                            <h3 class="text-base font-bold text-white mb-2 truncate">
                                <%= project.name %>
                            </h3>
                            <p class="text-sm text-slate-400 mb-4 flex-1 line-clamp-2">
                                <%= project.description %>
                            </p>
                            <div class="flex gap-2 mt-2 mb-4">
                                <% if (project.clone_url) { %>
                                    <button
                                        class="flex-1 px-2 py-1.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-md text-xs font-mono text-slate-300 transition-colors flex justify-center items-center gap-2"
                                        title="Copy HTTPS"
                                        onclick="event.stopPropagation(); executeCopyText(this, '<%= project.clone_url %>')">
                                        <i class="fa-solid fa-link"></i> HTTPS
                                    </button>
                                    <% } %>
                                        <% if (project.ssh_url) { %>
                                            <button
                                                class="flex-1 px-2 py-1.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-md text-xs font-mono text-slate-300 transition-colors flex justify-center items-center gap-2"
                                                title="Copy SSH"
                                                onclick="event.stopPropagation(); executeCopyText(this, '<%= project.ssh_url %>')">
                                                <i class="fa-brands fa-ssh"></i> SSH
                                            </button>
                                            <% } %>
                            </div>

                            <div class="flex items-center justify-between pt-4 border-t border-slate-700/50 mt-auto">
                                <span class="text-xs flex items-center gap-1.5">
                                    <span class="w-3 h-3 rounded-full bg-blue-500 flex-shrink-0"></span>
                                    <span class="text-slate-400">
                                        <%= project.language %>
                                    </span>
                                </span>
                                <span class="text-xs text-blue-400 group-hover:underline">
                                    View Details <i class="fa-solid fa-arrow-right ml-1"></i>
                                </span>
                            </div>
                        </div>
                        <% }); %>
                </div>
            </section>

            <!-- ===== Personal Clipboard Section ===== -->
            <section class="mt-8 mb-10">
                <h2 class="text-2xl font-bold text-white mb-6">My Clipboard</h2>
                <div class="card border-slate-600/50 p-0 overflow-hidden">
                    <div
                        class="bg-slate-800/80 px-4 py-3 border-b border-slate-700/50 flex justify-between items-center">
                        <h3 class="font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-clipboard-list text-purple-400"></i> Local Workspace
                        </h3>
                        <div class="text-xs text-slate-400 flex items-center gap-1.5" id="saveStatus">
                            <i class="fa-solid fa-check text-green-400"></i> Saved locally
                        </div>
                    </div>
                    <div>
                        <textarea id="personalClipboard"
                            class="w-full h-48 bg-transparent border-none p-4 text-slate-300 font-mono text-sm resize-y focus:outline-none focus:ring-1 focus:ring-slate-700 transition-colors"
                            placeholder="Paste notes, commands, or snippets here. It autosaves directly to your browser..."></textarea>
                    </div>
                    <div
                        class="bg-slate-800/40 px-4 py-2 border-t border-slate-700/50 flex justify-between items-center text-xs text-slate-500">
                        <span>Data stored securely in your browser's localStorage.</span>
                        <button
                            class="hover:text-white transition-colors flex items-center gap-1.5 p-1 rounded hover:bg-slate-700"
                            id="copyBtn">
                            <i class="fa-regular fa-copy"></i> Copy
                        </button>
                    </div>
                </div>
            </section>

            <!-- ===== SSH Terminal Section ===== -->
            <section class="mb-10">
                <div class="card border-slate-600/50 p-0 overflow-hidden">
                    <div
                        class="bg-slate-800/80 px-4 py-3 border-b border-slate-700/50 flex justify-between items-center">
                        <h3 class="font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-terminal text-green-400"></i> Server Terminal
                        </h3>
                        <div class="text-xs text-slate-400 flex items-center gap-1.5" id="terminalStatus">
                            <span class="w-2 h-2 rounded-full bg-slate-500 animate-pulse"></span> Connecting...
                        </div>
                    </div>
                    <div id="terminal-container" class="w-full bg-[#1e1e1e] p-2" style="height: 400px;">
                        <!-- xterm.js will mount here -->
                    </div>
                </div>
            </section>

            <!-- ===== Project Details Modal ===== -->
            <div id="projectModal" class="modal-overlay">
                <div class="modal">
                    <div class="flex justify-between items-start mb-6">
                        <h3 class="text-2xl font-bold text-white" id="modalTitle">Project Title</h3>
                        <button
                            class="p-2 text-slate-500 hover:text-white hover:bg-slate-800 rounded-lg transition-colors"
                            onclick="closeModal()">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                    <p class="text-slate-400 mb-4 leading-relaxed" id="modalDescription">Description</p>
                    <div class="flex gap-4 mb-6 text-sm text-blue-400">
                        <span id="modalLanguage"><i class="fa-solid fa-code mr-1"></i> Language</span>
                        <span id="modalStars"><i class="fa-solid fa-star mr-1 text-yellow-500"></i> <span>0</span>
                            Stars</span>
                    </div>
                    <div id="readmeSection" class="readme-content border-t border-slate-800 pt-6">
                        <div class="text-center text-slate-500 py-8">
                            <i class="fa-solid fa-spinner fa-spin text-xl mb-2 block"></i>
                            Loading README...
                        </div>
                    </div>

                    <!-- Clone Section -->
                    <div class="mt-6 pt-6 border-t border-slate-800 hidden" id="modalCloneSection">
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Clone
                            Repository</label>
                        <div class="flex flex-col sm:flex-row gap-2">
                            <div class="flex-1 flex bg-slate-900 rounded-lg border border-slate-700 overflow-hidden">
                                <span
                                    class="bg-slate-800 px-3 py-2 text-xs font-mono text-slate-400 border-r border-slate-700 flex items-center">HTTPS</span>
                                <input type="text" id="modalCloneHttps"
                                    class="bg-transparent border-none text-xs font-mono text-slate-300 px-3 py-2 w-full focus:outline-none"
                                    readonly>
                                <button onclick="copyToClipboard('modalCloneHttps')"
                                    class="px-3 text-slate-400 hover:text-white hover:bg-slate-700 transition-colors tooltip"
                                    title="Copy to clipboard">
                                    <i class="fa-regular fa-copy"></i>
                                </button>
                            </div>
                            <div class="flex-1 flex bg-slate-900 rounded-lg border border-slate-700 overflow-hidden">
                                <span
                                    class="bg-slate-800 px-3 py-2 text-xs font-mono text-slate-400 border-r border-slate-700 flex items-center">SSH</span>
                                <input type="text" id="modalCloneSsh"
                                    class="bg-transparent border-none text-xs font-mono text-slate-300 px-3 py-2 w-full focus:outline-none"
                                    readonly>
                                <button onclick="copyToClipboard('modalCloneSsh')"
                                    class="px-3 text-slate-400 hover:text-white hover:bg-slate-700 transition-colors tooltip"
                                    title="Copy to clipboard">
                                    <i class="fa-regular fa-copy"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-3 justify-end mt-6 pt-6 border-t border-slate-800">
                        <a href="#" id="modalLiveDemo" target="_blank"
                            class="btn btn-outline border-blue-500/30 text-blue-400 hover:bg-blue-500/10 hidden">
                            <i class="fa-solid fa-arrow-up-right-from-square"></i> Live Demo
                        </a>
                        <a href="#" id="modalLink" target="_blank" class="btn btn-primary">
                            <i class="fa-brands fa-github"></i> View Source
                        </a>
                    </div>
                </div>
            </div>

            <!-- ===== Add Service Modal ===== -->
            <div id="addServiceModal" class="modal-overlay">
                <div class="modal">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-xl font-bold text-white">Add New Service</h3>
                        <button
                            class="p-2 text-slate-500 hover:text-white hover:bg-slate-800 rounded-lg transition-colors"
                            onclick="closeAddServiceModal()">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                    <form action="/services/add" method="POST" class="space-y-4">
                        <div>
                            <label
                                class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5">Title
                                *</label>
                            <input type="text" name="title" required class="input-field" placeholder="e.g. My Server">
                        </div>
                        <div>
                            <label
                                class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5">URL
                                *</label>
                            <input type="text" name="url" required class="input-field"
                                placeholder="http://localhost:8080">
                        </div>
                        <div>
                            <label
                                class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5">Description</label>
                            <input type="text" name="description" class="input-field" placeholder="Short description">
                        </div>
                        <div>
                            <label
                                class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5">Icon
                                (FontAwesome class)</label>
                            <input type="text" name="icon" class="input-field" placeholder="fa-server">
                        </div>
                        <div class="flex items-center gap-3">
                            <input type="checkbox" id="isPrivate" name="isPrivate"
                                class="w-4 h-4 rounded border-slate-600 bg-slate-900 text-blue-600 focus:ring-blue-500">
                            <label for="isPrivate" class="text-sm text-slate-300">Private (requires login to
                                view)</label>
                        </div>
                        <div class="flex justify-end gap-3 pt-2">
                            <button type="button" class="btn btn-outline"
                                onclick="closeAddServiceModal()">Cancel</button>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-plus"></i> Add Service
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    initializeSortable();
                    initializeClipboard();
                });

                function initializeClipboard() {
                    const clipboard = document.getElementById('personalClipboard');
                    const saveStatus = document.getElementById('saveStatus');
                    const copyBtn = document.getElementById('copyBtn');
                    if (!clipboard) return;

                    let saveTimeout;
                    const savedText = localStorage.getItem('slogiker_personal_clipboard');
                    if (savedText) {
                        clipboard.value = savedText;
                    }

                    clipboard.addEventListener('input', () => {
                        saveStatus.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
                        saveStatus.classList.remove('text-green-400');
                        clearTimeout(saveTimeout);

                        saveTimeout = setTimeout(() => {
                            localStorage.setItem('slogiker_personal_clipboard', clipboard.value);
                            saveStatus.innerHTML = '<i class="fa-solid fa-check text-green-400"></i> Saved locally';
                            saveStatus.classList.add('text-green-400');
                        }, 600);
                    });

                    copyBtn.addEventListener('click', async () => {
                        try {
                            await navigator.clipboard.writeText(clipboard.value);
                            const ogHTML = copyBtn.innerHTML;
                            copyBtn.innerHTML = '<i class="fa-solid fa-check text-green-400"></i> Copied!';
                            setTimeout(() => copyBtn.innerHTML = ogHTML, 2000);
                        } catch (err) { }
                    });
                }

                function initializeSortable() {
                    const opts = {
                        animation: 150,
                        handle: '.drag-handle',
                        ghostClass: 'sortable-ghost',
                        dragClass: 'sortable-drag',
                        onEnd: (evt) => {
                            const list = evt.item.parentElement;
                            const isService = list.id === 'servicesGrid';
                            const order = Array.from(list.querySelectorAll('.sortable-item')).map(el => el.dataset.id);
                            fetch(isService ? '/services/reorder' : '/projects/reorder', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ order })
                            }).catch(err => console.error('Reorder error:', err));
                        }
                    };
                    const sg = document.getElementById('servicesGrid');
                    const pg = document.getElementById('projectsGrid');
                    if (sg) new Sortable(sg, opts);
                    if (pg) new Sortable(pg, opts);
                }



                // Service Management
                function openAddServiceModal() {
                    document.getElementById('addServiceModal').classList.add('active');
                }
                function closeAddServiceModal() {
                    document.getElementById('addServiceModal').classList.remove('active');
                }
                function deleteService(id) {
                    if (confirm('Delete this service?')) {
                        fetch(`/services/${id}`, { method: 'DELETE' })
                            .then(r => r.json())
                            .then(d => { if (d.success) location.reload(); })
                            .catch(() => alert('Failed to delete service'));
                    }
                }

                function copyToClipboard(elementId) {
                    const el = document.getElementById(elementId);
                    el.select();
                    document.execCommand('copy');
                    // Simple tooltip feedback
                    const btn = el.nextElementSibling;
                    const ogHtml = btn.innerHTML;
                    btn.innerHTML = '<i class="fa-solid fa-check text-green-400"></i>';
                    setTimeout(() => btn.innerHTML = ogHtml, 2000);
                }

                async function executeCopyText(buttonEl, text) {
                    try {
                        await navigator.clipboard.writeText(text);
                        const ogHtml = buttonEl.innerHTML;
                        buttonEl.innerHTML = '<i class="fa-solid fa-check text-green-400"></i> Copied';
                        buttonEl.classList.add('text-green-400', 'border-green-500/50');
                        setTimeout(() => {
                            buttonEl.innerHTML = ogHtml;
                            buttonEl.classList.remove('text-green-400', 'border-green-500/50');
                        }, 2000);
                    } catch (err) {
                        console.error('Copy failed:', err);
                    }
                }

                // Project Modal
                function openProjectFromCard(card) {
                    document.getElementById('modalTitle').textContent = card.dataset.name;
                    document.getElementById('modalDescription').textContent = card.dataset.description;
                    document.getElementById('modalLanguage').innerHTML = `<i class="fa-solid fa-code mr-1"></i>${card.dataset.language || 'Unknown'}`;
                    document.getElementById('modalStars').innerHTML = `<i class="fa-solid fa-star mr-1 text-yellow-500"></i><span>${card.dataset.stars}</span> Stars`;
                    document.getElementById('modalLink').href = card.dataset.url;

                    const demoBtn = document.getElementById('modalLiveDemo');
                    if (card.dataset.homepage && card.dataset.homepage.trim() !== '') {
                        demoBtn.href = card.dataset.homepage;
                        demoBtn.classList.remove('hidden');
                    } else {
                        demoBtn.classList.add('hidden');
                    }

                    const cloneSec = document.getElementById('modalCloneSection');
                    if (card.dataset.clone || card.dataset.ssh) {
                        document.getElementById('modalCloneHttps').value = `git clone ${card.dataset.clone}`;
                        document.getElementById('modalCloneSsh').value = `git clone ${card.dataset.ssh}`;
                        cloneSec.classList.remove('hidden');
                    } else {
                        cloneSec.classList.add('hidden');
                    }

                    const readme = document.getElementById('readmeSection');
                    readme.innerHTML = '<div class="text-center text-slate-500 py-8"><i class="fa-solid fa-spinner fa-spin text-xl mb-2 block"></i>Loading README...</div>';
                    document.getElementById('projectModal').classList.add('active');

                    fetch(card.dataset.url.replace('https://github.com/', 'https://api.github.com/repos/') + '/readme')
                        .then(r => r.json())
                        .then(data => {
                            if (data.content) {
                                const content = atob(data.content);
                                let interesting = '';
                                const features = content.match(/##?\s*[✨🎯📋]?\s*Features?\s*\n([\s\S]*?)(?=\n##|$)/i);
                                if (features) interesting += '<h3>✨ Features</h3>' + features[1].substring(0, 500);
                                const desc = content.match(/##?\s*(?:Description|About)\s*\n([\s\S]*?)(?=\n##|$)/i);
                                if (desc) interesting += '<h3>📝 About</h3>' + desc[1].substring(0, 300);
                                if (!interesting) interesting = content.split('\n').slice(0, 5).join(' ');
                                readme.innerHTML = parseMarkdown(interesting);
                            } else {
                                readme.innerHTML = '<p class="text-center text-slate-500">No README available</p>';
                            }
                        })
                        .catch(() => {
                            readme.innerHTML = '<p class="text-center text-slate-500">No README available</p>';
                        });
                }
                function closeModal() {
                    document.getElementById('projectModal').classList.remove('active');
                }

                // Close modals on overlay click or Escape key
                window.addEventListener('click', (e) => {
                    if (e.target.classList.contains('modal-overlay')) e.target.classList.remove('active');
                });
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') document.querySelectorAll('.modal-overlay.active').forEach(m => m.classList.remove('active'));
                });
            </script>

            <!-- xterm.js & Socket.io dependencies -->
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.css" />
            <script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.8.0/lib/xterm-addon-fit.js"></script>
            <script src="/socket.io/socket.io.js"></script>

            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const termContainer = document.getElementById('terminal-container');
                    if (termContainer) {
                        const term = new Terminal({
                            cursorBlink: true,
                            theme: { background: '#1e1e1e' },
                            fontFamily: 'monospace',
                            fontSize: 14
                        });
                        const fitAddon = new FitAddon.FitAddon();
                        term.loadAddon(fitAddon);
                        term.open(termContainer);

                        // Fit to container dimensions after opening
                        setTimeout(() => fitAddon.fit(), 100);

                        const socket = io();

                        socket.on('connect', () => {
                            document.getElementById('terminalStatus').innerHTML = '<span class="w-2 h-2 rounded-full bg-green-500"></span> Connected';
                            // Prompt backend for SSH connection
                            socket.emit('ssh-connect', '');
                        });

                        socket.on('disconnect', () => {
                            document.getElementById('terminalStatus').innerHTML = '<span class="w-2 h-2 rounded-full bg-red-500"></span> Disconnected';
                        });

                        socket.on('data', (data) => {
                            term.write(data);
                        });

                        term.onData((data) => {
                            socket.emit('data', data);
                        });

                        window.addEventListener('resize', () => {
                            fitAddon.fit();
                            socket.emit('resize', { cols: term.cols, rows: term.rows });
                        });
                    }
                });
            </script>

